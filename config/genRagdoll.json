    "wrist":    { "type": "spherical", "flexToward": [0, -1, 0], "twistFrom": "child", "limitsDeg": { "flex": [-60, 60], "side": [-30, 30], "twist": [-90, 90] } },
    "hip":      { "type": "spherical", "flexToward": [0, 0, 1], "twistFrom": "child", "limitsDeg": { "flex": [-20, 110], "side": [-40, 40], "twist": [-35, 35] } },
    "knee":     { "type": "hinge",     "flexToward": [0, 0, -1], "twistFrom": "child", "limitsDeg": { "flex": [0, 140] } },
    "ankle":    { "type": "spherical", "flexToward": [0, 1, 0], "twistFrom": "parent", "limitsDeg": { "flex": [-40, 25], "side": [-20, 20], "twist": [-15, 15] } }
